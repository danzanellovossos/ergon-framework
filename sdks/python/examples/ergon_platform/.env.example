# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env

# Credenciais da API key da Ergon Platform
ERGON_CLIENT_ID=
ERGON_CLIENT_SECRET=

# Opcional: company_id (inferido do token da API key quando omitido)
ERGON_COMPANY_ID=

# Workflow / fase para consumo de itens
ERGON_WORKFLOW_ID=
ERGON_PHASE_ID=

# Opcional: fase de destino aplicada no ack (move o item ao concluir)
ERGON_ACK_PHASE_ID=

# Producer (criacao de itens)
ERGON_CREATE_PHASE_ID=
ERGON_ATTACHMENT_FIELD_ID=

# Opcional: item pai usado no exemplo de criacao de card filho
# Se omitido, o exemplo usa o primeiro item retornado pelo fetch como pai.
ERGON_PARENT_ITEM_ID=
